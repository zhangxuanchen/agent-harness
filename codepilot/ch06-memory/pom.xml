<project xmlns="http://maven.apache.org/POM/4.0.0">
    <parent><groupId>io.etclovg</groupId><artifactId>codepilot</artifactId><version>1.0.0-SNAPSHOT</version></parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>codepilot-ch06-memory</artifactId>
    <name>Ch06 · C 层 — 上下文与记忆</name>

    <dependencies>
        <dependency><groupId>io.etclovg</groupId><artifactId>codepilot-core</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
        <dependency><groupId>io.agentscope</groupId><artifactId>agentscope-core</artifactId></dependency>

        <!-- SQLite FTS5 for episodic memory full-text search -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
        </dependency>

        <!-- AgentScope Knowledge/RAG（语义记忆）契约已在 agentscope-core 中提供；
             语义记忆的具体实现见 ch06 源码（MemoryManager / ContextCompactor）。 -->

        <!-- Redis for KV-cache stable prefix (optional) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI：用于 MemoryCandidateSelector（便宜小模型 side query）与
             SemanticMemoryDistiller（便宜小模型做蒸馏）。显式标注为可选：
             需要调用 LLM 时才在应用 pom 加具体 provider starter。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
