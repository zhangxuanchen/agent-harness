<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.etclovg</groupId>
    <artifactId>codepilot</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>CodePilot - Agent Harness Engineering Demo</name>
    <description>配套《Agent Harness 工程》的 Java 代码仓库，展示从裸模型(42%)到全七层Harness(82%)的逐层进化</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <!-- PRODUCTION: AgentScope Java 2.0.0 GA (2026-07-10). Do not use LATEST. -->
        <agentscope.version>2.0.0</agentscope.version>
        <!-- Spring AI BOM 版本：与 Spring Boot 3.5.x 匹配的 1.0.x Release Train -->
        <spring-ai.version>1.0.0-M6</spring-ai.version>
    </properties>

    <modules>
        <module>codepilot-core</module>
        <module>ch01-foundation</module>
        <module>ch02-definition</module>
        <module>ch03-behavior</module>
        <module>ch04-sandbox</module>
        <module>ch05-tools</module>
        <module>ch06-memory</module>
        <module>ch07-orchestration</module>
        <module>ch08-observability</module>
        <module>ch09-evaluation</module>
        <module>ch10-governance</module>
        <module>ch11-etcclovg</module>
        <module>ch12-model</module>
        <module>ch13-data</module>
        <module>ch14-planning</module>
        <module>ch15-multiagent</module>
        <module>ch16-mlops</module>
        <module>ch17-reliability</module>
        <module>ch18-case-study</module>
        <module>ch19-future</module>
        <module>codepilot-starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-dependencies-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-dashscope</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-openai</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <!-- Spring AI BOM：为 ch06 的 MemoryCandidateSelector / SemanticMemoryDistiller
                 提供统一版本管理。provider starter（如 openai / vertexai-gemini）
                 由应用模块按需引入，version 由本 BOM 管理。 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch01-foundation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch02-definition</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch03-behavior</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch04-sandbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch05-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch06-memory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch07-orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch08-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch09-evaluation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch10-governance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch11-etcclovg</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch12-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch13-data</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch14-planning</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch15-multiagent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch16-mlops</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch17-reliability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch18-case-study</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.etclovg</groupId>
                <artifactId>codepilot-ch19-future</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
